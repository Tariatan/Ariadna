<Window x:Class="Ariadna.Wpf.EntryDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ariadna.Wpf" Title="{Binding Caption}" Background="{Binding Theme.EditorBackground}" Foreground="White" FontSize="15"
        Width="1400" Height="950" MinWidth="1000" MinHeight="640" WindowStartupLocation="CenterOwner" Loaded="OnLoaded" Closed="OnClosed" PreviewKeyDown="OnKeyDown">
    <Window.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="DetailsStyles.xaml" /></ResourceDictionary.MergedDictionaries>
        <local:GenreIconConverter x:Key="GenreIcon" />
    </ResourceDictionary></Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Border BorderBrush="#40FFFFFF" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                <WrapPanel VerticalAlignment="Center">
                    <Border BorderBrush="#60FFFFFF" BorderThickness="1" CornerRadius="5" Margin="0,0,12,8">
                        <Grid Width="340">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="MediaPath" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Margin="0" ToolTip="{Binding Path}" LostKeyboardFocus="InspectChangedPath" />
                            <Button Grid.Column="1" Click="BrowsePath" ToolTip="Choose media path" Padding="9" Margin="0" BorderThickness="1,0,0,0" Background="Transparent">
                                <Path Data="M1,7 L1,3 L9,3 L12,6 L23,6 L23,9 M1,21 L5,9 L26,9 L22,21 Z" Stroke="#E0FFFFFF" StrokeThickness="1.7" Width="25" Height="23" Stretch="Uniform" />
                            </Button>
                        </Grid>
                    </Border>
                    <ItemsControl x:Name="FileMetrics" Margin="0,0,12,8" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="8,0,12,0" VerticalAlignment="Center">
                            <Path Data="{Binding Icon}" Stroke="#E0FFFFFF" StrokeThickness="1.7" Width="25" Height="25" Stretch="Uniform" Margin="0,0,9,0" />
                            <TextBlock Text="{Binding Value}" VerticalAlignment="Center" FontSize="14" />
                        </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="FileInfo" Text="Reading file information…" VerticalAlignment="Center" Margin="0,0,12,8" FontSize="13" />
                    <Border BorderBrush="#30FFFFFF" BorderThickness="1,0,0,0" Padding="16,0,4,0" Margin="0,0,12,8" VerticalAlignment="Center">
                        <ItemsControl x:Name="AudioLanguages">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,0,16,0" ToolTip="{Binding Name}">
                                <Image Source="{Binding Icon}" Width="30" Height="21" Stretch="Uniform" Margin="0,0,9,0" />
                                <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <Border BorderBrush="#30FFFFFF" BorderThickness="1,0,0,0" Padding="12,0,0,0" Margin="0,0,0,8" VerticalAlignment="Center">
                        <CheckBox x:Name="IgnorePath" Content="Ignore path" Margin="0" ToolTip="Ignore this path when Save is pressed" />
                    </Border>
                </WrapPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" /><Button x:Name="SaveButton" Content="Save" Click="Save" MinWidth="100" Background="#FF7931AA" BorderBrush="#FFA95AD0" />
            </StackPanel>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3.3*" /></Grid.ColumnDefinitions>
            <Grid Margin="0,0,20,0">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Background="#10000000">
                    <TextBlock Text="No poster" Foreground="#A0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image x:Name="PosterImage" Source="{Binding Poster}" Stretch="Uniform" MouseDown="PosterDoubleClick" />
                </Grid>
                <UniformGrid Grid.Row="1" Columns="2" Margin="0,8,0,0">
                    <Button Content="Choose poster…" Tag="" Click="ReplaceImage" /><Button Content="Paste image" Tag="" Click="PasteImage" />
                </UniformGrid>
            </Grid>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                <StackPanel>
                    <Label Content="Title" Target="{Binding ElementName=TitleText}" /><TextBox x:Name="TitleText" FontSize="25" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Content="Original title" /><TextBox FontSize="19" Text="{Binding OriginalTitle, UpdateSourceTrigger=PropertyChanged}" />
                    <Grid Margin="0,2,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0"><Label Content="Year" /><TextBox Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel Grid.Column="1">
                            <Label Content="Genres" />
                            <ListBox x:Name="GenreList" ItemsSource="{Binding Genres}" Background="Transparent" BorderThickness="0" Foreground="White"
                                     ItemContainerStyle="{StaticResource PortraitItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MinHeight="90">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemTemplate><DataTemplate><StackPanel Width="86">
                                    <Border Background="White" CornerRadius="4" Width="62" Height="62" Padding="4"><Image Source="{Binding Converter={StaticResource GenreIcon}}" Stretch="Uniform" /></Border>
                                    <TextBlock Text="{Binding}" TextAlignment="Center" TextWrapping="Wrap" FontSize="13" Margin="0,5,0,0" />
                                </StackPanel></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <CheckBox Content="Wishlist" IsChecked="{Binding Wanted}" />
                            <CheckBox Content="VR" IsChecked="{Binding Vr}" Visibility="{Binding IsGame, Converter={StaticResource Visibility}}" />
                        </StackPanel>
                    </Grid>
                    <Expander Header="Edit genres" Foreground="White" Margin="0,0,0,12">
                        <WrapPanel Margin="0,8,0,0">
                            <ComboBox x:Name="GenreName" ItemsSource="{Binding AvailableGenres}" IsEditable="True" Width="180" />
                            <Button Content="Add" Click="AddGenre" /><Button Content="Paste" Click="PasteGenres" /><Button Content="Remove selected" Click="RemoveGenre" />
                        </WrapPanel>
                    </Expander>
                    <DockPanel Margin="0,0,0,6">
                        <Button x:Name="MetadataButton" DockPanel.Dock="Right" Content="Find on TMDb…" Click="FindMetadata" Visibility="{Binding IsMovie, Converter={StaticResource Visibility}}" />
                        <Label Content="Description" VerticalAlignment="Bottom" Visibility="{Binding HasDescription, Converter={StaticResource Visibility}}" />
                    </DockPanel>
                    <TextBox Height="125" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" Visibility="{Binding HasDescription, Converter={StaticResource Visibility}}" />
                    <StackPanel Visibility="{Binding IsGame, Converter={StaticResource Visibility}}">
                        <Label Content="Version" /><TextBox Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}" />
                        <Image x:Name="SelectedPreview" Height="230" Stretch="Uniform" />
                        <WrapPanel>
                            <Button Content="Preview 1" Tag="1" Click="SelectPreview" /><Button Content="Preview 2" Tag="2" Click="SelectPreview" />
                            <Button Content="Preview 3" Tag="3" Click="SelectPreview" /><Button Content="Preview 4" Tag="4" Click="SelectPreview" />
                            <Button x:Name="PreviewReplace" Content="Replace preview…" Tag="1" Click="ReplaceImage" /><Button x:Name="PreviewPaste" Content="Paste preview" Tag="1" Click="PasteImage" />
                        </WrapPanel>
                    </StackPanel>
                    <Grid Margin="0,4,0,0" Visibility="{Binding HasPeople, Converter={StaticResource Visibility}}">
                        <Grid.ColumnDefinitions><ColumnDefinition x:Name="PeopleColumn" Width="230" /><ColumnDefinition x:Name="CastColumn" Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource DetailsSection}" Margin="0,0,10,0">
                            <StackPanel><TextBlock Text="{Binding PeopleLabel}" FontSize="18" Margin="0,0,0,8" /><local:PeopleEditorView x:Name="PeopleEditor" /></StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource DetailsSection}" Visibility="{Binding IsMovie, Converter={StaticResource Visibility}}">
                            <StackPanel><TextBlock Text="Cast" FontSize="18" Margin="0,0,0,8" /><local:PeopleEditorView x:Name="CastEditor" /></StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>