<Window x:Class="Ariadna.Wpf.MetadataChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Choose TMDb match" Width="700" Height="430" MinWidth="500" MinHeight="300"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="#400040" Foreground="White" FontFamily="Segoe UI" FontSize="15">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="DetailsStyles.xaml" /></ResourceDictionary.MergedDictionaries>
            <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Margin" Value="3" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#18FFFFFF" /></Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="#30FFFFFF" />
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="#80FFFFFF" />
                                    <Setter Property="Foreground" Value="Gold" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderBrush="#60FFFFFF" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Background="#30000000" BorderBrush="#35FFFFFF" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="Ariadna" Margin="16,0" VerticalAlignment="Center" />
                    <Button Content="&#x2715;" AutomationProperties.Name="Close" Width="40" HorizontalAlignment="Right" Padding="0" Margin="0" Background="Transparent" BorderThickness="0" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Dismiss" />
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Margin="28,24,28,16">
                <TextBlock Text="Choose TMDb match" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Select the matching movie or series." Foreground="#E8FFFFFF" Margin="0,8,0,0" />
            </StackPanel>
            <ListBox x:Name="Matches" Grid.Row="2" Margin="24,0,24,20" Background="#10000000" Foreground="White" BorderBrush="#60FFFFFF" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="ChooseOnDoubleClick">
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,22">
                <Button Content="Cancel" MinWidth="100" IsCancel="True" Margin="0,0,10,0" Click="Dismiss" />
                <Button x:Name="ChooseButton" Content="Choose" MinWidth="100" IsDefault="True" Margin="0" Click="Choose" />
            </StackPanel>
        </Grid>
    </Border>
</Window>