<UserControl x:Class="Ariadna.Wpf.PosterCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded" DataContextChanged="OnDataContextChanged">
    <Border x:Name="Highlight" Margin="5" Padding="5" CornerRadius="0">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="Gray" />
                        <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#41FFFFFF" Offset="0" />
                                    <GradientStop Color="#FF101010" Offset="1" />
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <DataTrigger Binding="{Binding Selected}" Value="True">
                        <Setter Property="BorderBrush" Value="Gray" />
                        <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#6EFFFFFF" Offset="0" />
                                    <GradientStop Color="#FF101010" Offset="1" />
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                        <DataTrigger.EnterActions>
                            <BeginStoryboard x:Name="SelectionBlink">
                                <Storyboard>
                                    <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                  Duration="0:0:0.42" FillBehavior="Stop">
                                        <DiscreteColorKeyFrame KeyTime="0:0:0" Value="White" />
                                        <DiscreteColorKeyFrame KeyTime="0:0:0.07" Value="Gray" />
                                        <DiscreteColorKeyFrame KeyTime="0:0:0.14" Value="White" />
                                        <DiscreteColorKeyFrame KeyTime="0:0:0.21" Value="Gray" />
                                        <DiscreteColorKeyFrame KeyTime="0:0:0.28" Value="White" />
                                        <DiscreteColorKeyFrame KeyTime="0:0:0.35" Value="Gray" />
                                    </ColorAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <RemoveStoryboard BeginStoryboardName="SelectionBlink" />
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid ToolTip="{Binding Entry.Path}">
            <Grid.RowDefinitions><RowDefinition Height="380" /><RowDefinition Height="36" /></Grid.RowDefinitions>
            <TextBlock Text="?" FontSize="256" AutomationProperties.Name="Missing poster" Foreground="#777777" VerticalAlignment="Center" HorizontalAlignment="Center" >
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Source, ElementName=Poster}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            <Image x:Name="Poster" Stretch="Uniform" />
            <TextBlock Grid.Row="1" Text="{Binding Caption}" Foreground="White" TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis" LineHeight="18" LineStackingStrategy="BlockLineHeight" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Grid.RowSpan="1" />
        </Grid>
    </Border>
</UserControl>
