<UserControl x:Class="Ariadna.Wpf.PeopleEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="DetailsStyles.xaml" /></ResourceDictionary.MergedDictionaries>
    </ResourceDictionary></UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBox x:Name="NewName" ToolTip="Person name" Margin="0,0,0,4" FontSize="13" KeyDown="OnNewNameKeyDown" />
            <WrapPanel>
                <WrapPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource DetailsButton}"><Setter Property="Padding" Value="7,5" /><Setter Property="FontSize" Value="12" /></Style></WrapPanel.Resources>
                <Button Content="Add" Click="Add" /><Button Content="Paste" Click="Paste" /><Button Content="Remove" Click="Remove" />
                <Button Content="Photo…" Click="ReplacePhoto" /><Button x:Name="DownloadButton" Content="Find photo" Click="DownloadPhoto" />
            </WrapPanel>
        </StackPanel>
        <ListBox x:Name="People" Background="Transparent" BorderThickness="0" Foreground="White" Height="230"
                 SelectionMode="Single" ItemContainerStyle="{DynamicResource PortraitItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewKeyDown="OnKeyDown">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate><DataTemplate><StackPanel Width="112">
                <Grid Height="145" Background="#18000000" MouseDown="OnPhotoDoubleClick">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="♙" FontSize="48" TextAlignment="Center" Foreground="#80FFFFFF" /><TextBlock Text="No photo" FontSize="12" Foreground="#A0FFFFFF" /></StackPanel>
                    <Image Source="{Binding Portrait}" Stretch="Uniform" />
                </Grid>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" TextWrapping="Wrap" FontSize="13" Padding="2"
                         Margin="0,6,0,0" BorderThickness="0" Background="Transparent" ToolTip="Edit name" GotKeyboardFocus="OnNameFocus" />
            </StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>