<UserControl x:Class="Ariadna.Wpf.PeopleEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="DetailsStyles.xaml" /></ResourceDictionary.MergedDictionaries>
        <Style x:Key="NameEditor" TargetType="TextBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#3399FF" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" BorderThickness="0" Padding="0" Focusable="False">
                                <ScrollViewer.Template>
                                    <ControlTemplate TargetType="ScrollViewer">
                                        <!-- TextBoxView adds 2px on each side; offset that inset to align with the name label. -->
                                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="-2,0" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="False" />
                                    </ControlTemplate>
                                </ScrollViewer.Template>
                            </ScrollViewer>
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Margin="-1" IsHitTestVisible="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="AuthorName">
            <Grid MaxWidth="280">
                <TextBlock x:Name="AuthorLabel" Text="{Binding Name}" TextWrapping="Wrap" FontSize="13" MouseLeftButtonDown="OnNameDoubleClick" />
                <TextBox Style="{StaticResource NameEditor}" Width="{Binding ActualWidth, ElementName=AuthorLabel}" Height="{Binding ActualHeight, ElementName=AuthorLabel}" Visibility="Collapsed" KeyDown="OnNameKeyDown" LostKeyboardFocus="OnNameLostFocus" />
            </Grid>
        </DataTemplate>
    </ResourceDictionary></UserControl.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RefreshButton" Content="↻" Style="{StaticResource RefreshButtonStyle}" Click="Refresh" ToolTip="Refresh people from IMDb / TMDb" FontSize="14" Padding="7,0" Margin="5,0,0,0" Visibility="Collapsed" />
                <Button x:Name="PasteButton" Content="↓" Click="Paste" ToolTip="Paste people from clipboard" FontSize="14" Padding="7,0" Margin="5,0,0,0" />
                <Button x:Name="AddButton" Content="+" Click="Add" ToolTip="Add New Entry" FontSize="14" Padding="7,0" Margin="5,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="PanelLabel" FontSize="14" VerticalAlignment="Center" />
        </DockPanel>
        <ListBox x:Name="People" Background="Transparent" BorderThickness="0" Foreground="White" Height="158" Padding="0"
                 SelectionMode="Single" ItemContainerStyle="{DynamicResource PortraitItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewKeyDown="OnKeyDown" PreviewMouseWheel="OnPeopleMouseWheel" ScrollViewer.ScrollChanged="OnPeopleScrollChanged">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate><DataTemplate><StackPanel Width="80" Height="138">
                <Grid Height="100" Background="#18000000" MouseDown="OnPhotoDoubleClick">
                    <TextBlock Text="?" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#80FFFFFF" AutomationProperties.Name="Missing portrait" >
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Portrait}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Image Source="{Binding Portrait}" Stretch="Uniform" />
                </Grid>
                <Grid Margin="0,2,0,0" Height="36">
                    <TextBlock x:Name="PersonLabel" Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" FontSize="13" MouseLeftButtonDown="OnNameDoubleClick" />
                    <TextBox Style="{StaticResource NameEditor}" Width="{Binding ActualWidth, ElementName=PersonLabel}" Height="{Binding ActualHeight, ElementName=PersonLabel}" TextAlignment="Center" Visibility="Collapsed" KeyDown="OnNameKeyDown" LostKeyboardFocus="OnNameLostFocus" />
                </Grid>
            </StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
